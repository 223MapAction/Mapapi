PWD=/app
PORT=6543
PYTHON_SETUPTOOLS_VERSION=65.5.1
HOME=/root
LANG=C.UTF-8
PYTHONDONTWRITEBYCODE=1
SECRET_KEY=djang-hnfffffnnxxc
GPG_KEY=gpg_key
DJANGO_SUPERUSER_PASSWORD=bypass
DJANGO_SUPERUSER_EMAIL=admin@admin.com
TERM=xterm
DB_HOST=db_host
TWILIO_PHONE_NUMBER=number
SHLVL=1
POSTGRES_USER=postgres_user
DJANGO_SUPERUSER_USERNAME=admin
PYTHON_PIP_VERSION=23.0.1
PYTHON_GET_PIP_SHA256=dfe9fd5c28dc98b5ac17979a953ea550cec37ae1b47a5116007395bfacff2ab9
DJANGO_SUPERUSER_FIRST_NAME=name
IOS_CLIENT_ID=jjdd-jdddn.apps.googleusercontent.com
TWILIO_AUTH_TOKEN=auth_token
PYTHON_GET_PIP_URL=https://github.com/pypa/get-pip/raw/dbf0c85f76fb6e1ab42aa672ffca6f0a675d9ee4/public/get-pip.py
WEB_CLIENT_SECRET=web_client_secret
WEB_CLIENT_ID=web_client_id.apps.googleusercontent.com
DJANGO_SUPERUSER_LAST_NAME=lastname
PATH=/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ANDROID_CLIENT_ID=android_client_id.apps.googleusercontent.com
POSTGRES_DB=postgres
TEST_POSTGRES_DB=postgres
_=/usr/bin/env
SUPABASE_URL=https://supabase_url.supabase.co
SUPABASE_ANON_KEY=supabase_anon_key
USE_SUPABASE_STORAGE=True
EMAIL_HOST = email_host
EMAIL_HOST_USER = email_host_user
EMAIL_HOST_PASSWORD = email_host_password
# Firebase Cloud Messaging : renseigner UNE SEULE de ces 3 variables selon l'environnement.
# - FCM_CREDENTIALS_PATH : local/Docker, fichier monté sur disque.
# - FCM_CREDENTIALS_JSON_BASE64 : CI/CD (GitHub Actions -> .env), contenu du JSON encodé en base64.
# - FCM_CREDENTIALS_JSON : Railway/AWS, JSON collé tel quel dans l'éditeur de variables.
FCM_CREDENTIALS_PATH=/path/to/firebase-service-account.json
FCM_CREDENTIALS_JSON_BASE64=
FCM_CREDENTIALS_JSON=

# Observability. Leave SENTRY_DSN empty to disable all network transmission.
# Error events remain at 100%; traces and standalone Sentry Logs are opt-in so
# the default is inexpensive. INFO logs still go to structured JSON on stdout
# and become breadcrumbs on any captured error.
LOG_LEVEL=INFO
ACCESS_LOG_LEVEL=WARNING
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_SERVER_NAME=map-action-api
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENABLE_LOGS=False
